<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="336 228"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png" size="100% 100%"/>

    <text size="320 10" pos="8 8" textalign="MIDDLE" color="black" textscale="0.9"
          label="$(rp_crossroads.gui.crossings)"/>

    <list id="roads" size="320 148" pos="8 22">
        <box size="100% 60" linewidth="1">
            <text id="name" size="312 10" pos="4 2" color="black" textscale="0.8"/>
            <button id="mode" size="156 17" pos="4 16"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png" color="black"/>
            <button id="strategy" size="152 17" pos="160 16"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png" color="black"/>
            <button id="lower" size="20 17" pos="4 37"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png" label="-" color="black"/>
            <text id="height" size="100 12" pos="28 39" textalign="MIDDLE" color="black" textscale="0.7"/>
            <button id="raise" size="20 17" pos="132 37"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png" label="+" color="black"/>
            <button id="preview" size="152 17" pos="160 37"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png" color="black"/>
        </box>
    </list>

    <text id="status" size="320 26" pos="8 174" color="red" textscale="0.7"/>
    <button id="reset" size="236 17" pos="8 202"
            source="minecolonies:textures/gui/builderhut/builder_button_large.png"
            label="$(rp_crossroads.gui.reset_manual)" color="black"/>
    <button id="back" size="76 17" pos="252 202"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_small.png"
            label="$(rp_crossroads.gui.back)" color="black"/>
</window>
