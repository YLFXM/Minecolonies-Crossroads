<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="280 196"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_sketch.png" size="100% 100%"/>

    <text id="title" size="260 12" pos="10 8" textalign="MIDDLE" color="black"
          label="$(rp_crossroads.gui.road_controller)"/>
    <text id="name" size="260 12" pos="10 24" textalign="MIDDLE" color="black"/>
    <text id="state" size="260 10" pos="10 38" textalign="MIDDLE" color="black"/>
    <text id="detail" size="260 10" pos="10 52" textalign="MIDDLE" color="black"/>

    <button id="build" size="120 17" pos="10 70"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.build)" color="black"/>
    <button id="repair" size="120 17" pos="135 70"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.repair)" color="black"/>

    <button id="edit" size="120 17" pos="10 90"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.edit_blueprint)" color="black"/>
    <button id="crossings" size="120 17" pos="135 90"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.crossings)" color="black"/>

    <button id="remove" size="260 17" pos="10 110"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.remove)" color="black"/>

    <button id="style" size="125 17" pos="10 132"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.style_entry)" color="black"/>
    <button id="series" size="125 17" pos="135 132"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.series)" color="black"/>

    <button id="lampDown" size="20 17" pos="10 152"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="-" color="black"/>
    <button id="lampValue" size="30 17" pos="33 152"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="4" color="black"/>
    <button id="lampUp" size="20 17" pos="66 152"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="+" color="black"/>
    <text id="lampLabel" size="55 17" pos="90 152" textalign="MIDDLE" color="black"
          label="$(rp_crossroads.gui.lamp_spacing)"/>
    <button id="mirror" size="95 17" pos="150 152"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.mirror_off)" color="black"/>

    <text id="issue" size="260 18" pos="10 172" color="red" textscale="0.8"/>
</window>
