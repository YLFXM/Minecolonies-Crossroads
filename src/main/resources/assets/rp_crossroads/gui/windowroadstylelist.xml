<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="420 240" lightbox="true"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <button id="cancel" size="86 17" pos="3 3"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.cancel)" color="black"/>
    <input id="filter" size="129 17" pos="150 3" maxlength="25" color="white"/>
    <text id="filterHint" size="120 10" pos="154 8" color="white" textscale="0.7"
          label="$(rp_crossroads.gui.style_search)"/>

    <text id="header" size="400 10" pos="10 24" textalign="MIDDLE" color="white" textscale="0.9"/>

    <list id="styles" size="420 176" pos="0 40">
        <box size="100% 100" linewidth="0">
            <box id="box0" size="200 100" pos="6 0" linewidth="0">
                <image id="icon" size="80 80" pos="4 8"
                       source="structurize:textures/item/sceptersteel.png"/>
                <text id="name" size="108 14" pos="88 6" color="white" textscale="1.2"/>
                <text id="desc" size="108 32" pos="88 22" color="white" textscale="0.6"/>
                <text id="authors" size="108 10" pos="88 56" color="white" textscale="0.8"/>
                <button id="select" size="86 17" pos="110 78"
                        source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
                        label="$(rp_crossroads.gui.style_open)" color="black"/>
            </box>
            <box id="box1" size="200 100" pos="214 0" linewidth="0">
                <image id="icon" size="80 80" pos="4 8"
                       source="structurize:textures/item/sceptersteel.png"/>
                <text id="name" size="108 14" pos="88 6" color="white" textscale="1.2"/>
                <text id="desc" size="108 32" pos="88 22" color="white" textscale="0.6"/>
                <text id="authors" size="108 10" pos="88 56" color="white" textscale="0.8"/>
                <button id="select" size="86 17" pos="110 78"
                        source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
                        label="$(rp_crossroads.gui.style_open)" color="black"/>
            </box>
        </box>
    </list>

    <list id="series" size="420 176" pos="0 40">
        <box size="100% 28" linewidth="0">
            <button id="entry" size="200 17" pos="110 5"
                    source="minecolonies:textures/gui/builderhut/builder_button_medium.png" color="black"/>
        </box>
    </list>

    <text id="status" size="400 10" pos="10 218" textalign="MIDDLE" color="white" textscale="0.7"/>
</window>
