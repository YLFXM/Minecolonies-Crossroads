<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="300 208"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_sketch.png" size="100% 100%"/>

    <text id="title" size="280 12" pos="10 8" textalign="MIDDLE" color="black"
          label="$(rp_crossroads.gui.wand_title)"/>
    <text id="summary" size="280 20" pos="10 24" color="black" textalign="MIDDLE"/>
    <text id="bound" size="280 10" pos="10 46" color="black" textalign="MIDDLE"/>
    <text id="state" size="280 10" pos="10 58" color="black" textalign="MIDDLE"/>

    <button id="plan" size="260 17" pos="8 78"
            source="minecolonies:textures/gui/builderhut/builder_button_large.png"
            label="$(rp_crossroads.gui.wand_create)" color="black"/>

    <button id="mirror" size="88 17" pos="8 106"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.mirror_off)" color="black"/>
    <button id="clear" size="88 17" pos="104 106"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.clear)" color="black"/>

    <text id="lampLabel" size="110 10" pos="8 134" color="black"
          label="$(rp_crossroads.gui.lamp_spacing)"/>
    <button id="lampDown" size="20 17" pos="124 130"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="-" color="black"/>
    <button id="lampValue" size="30 17" pos="147 130"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="4" color="black"/>
    <button id="lampUp" size="20 17" pos="180 130"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="+" color="black"/>
    <button id="autoPlan" size="136 17" pos="8 153" source="minecolonies:textures/gui/builderhut/builder_button_large.png" label="$(rp_crossroads.gui.auto_plan)" color="black"/>
    <button id="crossings" size="136 17" pos="152 153" source="minecolonies:textures/gui/builderhut/builder_button_large.png" label="$(rp_crossroads.gui.crossings)" color="black"/>
    <text id="planning" size="280 26" pos="10 176" color="red" textscale="0.8"/>
</window>
