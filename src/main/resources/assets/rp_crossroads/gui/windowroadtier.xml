<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="232 144"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png" size="100% 100%"/>

    <text id="title" size="216 10" pos="8 10" textalign="MIDDLE" color="black" textscale="0.9"
