<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="288 180"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper_wide2.png" size="100% 100%"/>

    <text id="title" size="272 10" pos="8 8" textalign="MIDDLE" color="black" textscale="0.9"
          label="$(rp_crossroads.gui.work_orders_title)"/>
    <text id="subtitle" size="272 9" pos="8 19" textalign="MIDDLE" color="black" textscale="0.7"/>

    <list id="orders" size="272 92" pos="8 30">
        <box size="100% 20" linewidth="1">
            <button id="select" size="14 15" pos="2 2"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png"
                    label="[ ]" color="black"/>
            <text id="orderName" size="246 10" pos="20 1" color="black" textscale="0.8"/>
            <text id="orderDetail" size="246 9" pos="20 10" color="black" textscale="0.7"/>
        </box>
    </list>

    <button id="selectAll" size="86 17" pos="8 128"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.select_all)" color="black"/>
    <button id="clear" size="86 17" pos="98 128"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.clear)" color="black"/>
    <button id="close" size="86 17" pos="194 128"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png"
            label="$(rp_crossroads.gui.close)" color="black"/>

    <button id="cancelOrders" size="272 17" pos="8 149"
            source="minecolonies:textures/gui/builderhut/builder_button_large.png"
            label="$(rp_crossroads.gui.cancel_selected_orders)" color="black"/>
</window>
